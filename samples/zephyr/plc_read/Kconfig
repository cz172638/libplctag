mainmenu "libplctag plc_read sample"

config PLC_READ_GATEWAY
	string "PLC IP address"
	default "192.168.1.10"

config PLC_READ_PATH
	string "CIP route path (backplane,slot)"
	default "1,0"

config PLC_READ_PLC_TYPE
	string "libplctag plc= attribute"
	default "ControlLogix"

config PLC_READ_TAG_NAME
	string "Tag to read"
	default "TestDINTArray"

config PLC_READ_ELEM_COUNT
	int "Number of 32-bit elements"
	default 10

config PLC_READ_PERIOD_MS
	int "Read period in milliseconds (0 = back-to-back)"
	default 1000

config PLC_READ_ATTRS
	string "Full libplctag attribute string (overrides the options above)"
	default ""
	help
	  When set, used verbatim for plc_tag_create(), e.g.
	  "protocol=modbus-tcp&gateway=10.0.0.5:502&path=0&elem_count=10&name=hr0"
	  or "protocol=ab-eip&gateway=10.0.0.6&path=18,10.0.0.6&plc=omron-njnx&elem_size=4&elem_count=10&name=Arr".
	  Elements are read as 32-bit integers, except Modbus registers (16-bit).

config PLC_READ_DEBUG
	int "libplctag debug level (0-5)"
	default 1

config PLC_READ_TIMEOUT_MS
	int "Per-operation timeout in milliseconds"
	default 5000

source "Kconfig.zephyr"
